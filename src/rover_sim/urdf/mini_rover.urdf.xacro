<?xml version="1.0"?>
<robot name="mini_rover" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_length" value="0.40"/>
  <xacro:property name="chassis_width" value="0.26"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass" value="3.0"/>
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_mass" value="0.3"/>
  <xacro:property name="wheel_separation" value="0.32"/>
  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_x" value="0.15"/>
  <xacro:property name="lidar_x" value="0.10"/>
  <xacro:property name="lidar_z" value="0.20"/>

  <material name="chassis"><color rgba="0.92 0.92 0.94 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="lidar"><color rgba="0.10 0.35 0.85 1"/></material>

  <xacro:macro name="caster" params="x">
    <visual>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="dark"/>
    </visual>
    <collision>
      <origin xyz="${x} 0 ${caster_radius - wheel_radius}"/>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
  </xacro:macro>

  <!-- base_link: ground level, under the center of the wheel axle -->
  <link name="base_link"/>

  <link name="chassis">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <material name="chassis"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
    </collision>
    <xacro:caster x="${caster_x}"/>
    <xacro:caster x="${-caster_x}"/>
    <visual>
      <origin xyz="${lidar_x} 0 ${(chassis_height / 2 + lidar_z - wheel_radius - 0.02) / 2}"/>
      <geometry><cylinder radius="0.01" length="${lidar_z - wheel_radius - 0.02 - chassis_height / 2}"/></geometry>
      <material name="dark"/>
    </visual>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass * (chassis_width**2 + chassis_height**2) / 12}" ixy="0" ixz="0"
               iyy="${chassis_mass * (chassis_length**2 + chassis_height**2) / 12}" iyz="0"
               izz="${chassis_mass * (chassis_length**2 + chassis_width**2) / 12}"/>
    </inertial>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
    <origin xyz="0 0 ${wheel_radius}"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel">
      <visual>
        <origin rpy="${pi / 2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <geometry><sphere radius="${wheel_radius}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}" ixy="0" ixz="0"
                 iyy="${wheel_mass * wheel_radius**2 / 2}" iyz="0"
                 izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}"/>
      </inertial>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
    <gazebo reference="${side}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>
  <xacro:wheel side="left" y="${wheel_separation / 2}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2}"/>

  <link name="laser_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>

  <gazebo reference="chassis">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <ignition_frame_id>laser_link</ignition_frame_id>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.12414</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/mini_rover/cmd_vel</topic>
      <max_linear_velocity>1.5</max_linear_velocity>
      <min_linear_velocity>-1.5</min_linear_velocity>
      <max_angular_velocity>3.0</max_angular_velocity>
      <min_angular_velocity>-3.0</min_angular_velocity>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>

</robot>